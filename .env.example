# ModelPassport settings. Copy this file to .env in the repository root and fill in the values.
# .env is never committed. The Python services load it from the repository root.

# ---- LLM: any OpenAI compatible endpoint. Used by factory_core and redev_engine only. ----
# Base URL of the endpoint. Default: the Gemini API OpenAI compatible endpoint from Google AI Studio.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# API key for that endpoint. Not needed in replay mode. Never write a real key into any committed file.
LLM_API_KEY=
# Model id for the discovery, documentation and redevelopment agents. Check the provider's current model list.
LLM_MODEL=
# Optional model id for the validator agent. A different model from LLM_MODEL strengthens validation independence.
LLM_MODEL_VALIDATOR=
# live: answer from the reply cache, call the provider on a miss. replay: cache only, no key and no network needed.
LLM_MODE=live
# Sampling temperature for every LLM call. 0 keeps replies as repeatable as the provider allows.
LLM_TEMPERATURE=0

# ---- Service addresses ----
# factory_core API, the only service the dashboard calls.
FACTORY_CORE_URL=http://localhost:8000
# redev_engine API, called by factory_core only.
REDEV_ENGINE_URL=http://localhost:8001
# validation_lab API, called by factory_core only.
VALIDATION_LAB_URL=http://localhost:8002
# true: factory_core answers from contracts/examples/ instead of calling redev_engine and validation_lab.
USE_STUBS=false

# ---- Paths, relative to the repository root ----
# Folder that holds the legacy model estate.
ESTATE_DIR=model_estate
# Folder for run outputs. Ignored by git.
ARTIFACTS_DIR=artifacts

# ---- Optional ----
# MLflow tracking URI, for example http://localhost:5000 or an Azure ML workspace URI. Empty disables tracking.
MLFLOW_TRACKING_URI=

# The dashboard keeps its own settings (VITE_API_MODE, VITE_API_BASE_URL) in factory_console/.env.
